[Unit]
Description=Upscale Lab ASP.NET Core API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/UpscaleLab/backend/publish
ExecStart=/home/ubuntu/.dotnet8/dotnet /home/ubuntu/UpscaleLab/backend/publish/UpscaleLab.Api.dll
EnvironmentFile=/etc/upscale-lab/upscale-lab.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
