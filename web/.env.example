# Local demo: no API required. Cloud builds use scripts/build-cloud.mjs and same-origin API.
VITE_APP_MODE=demo
# Only set for a separate API origin; do not append /api. Never add secrets here.
VITE_API_BASE_URL=
# Local API target for dev:production-ui / preview:production-ui; no credentials.
LOCAL_API_TARGET=http://127.0.0.1:5080
# Required by build:cloud. Public SDK client key; never put a Toss secret key here.
# Current checkout supports test payments only. Keep the real value in .env.production.local or the build environment.
VITE_TOSS_CLIENT_KEY=
