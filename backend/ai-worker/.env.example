# Variable reference only. Export in your shell; worker does not automatically load .env.
UPSCALE_WORKER_API_KEY=REPLACE_WITH_RANDOM_SHARED_KEY_AT_LEAST_32_CHARS
UPSCALE_WORKER_WORK_DIR=/srv/upscale-worker/jobs
UPSCALE_WORKER_TIMEOUT_SECONDS=1800
UPSCALE_WORKER_MAX_UPLOAD_BYTES=20971520
UPSCALE_WORKER_MAX_INPUT_PIXELS=16000000
UPSCALE_WORKER_MAX_OUTPUT_PIXELS=64000000
UPSCALE_WORKER_MAX_ARCHIVE_BYTES=268435456
UPSCALE_WORKER_REALESRGAN_REPOSITORY=/srv/models/Real-ESRGAN
UPSCALE_WORKER_REALESRGAN_PYTHON=/srv/envs/realesrgan/bin/python
UPSCALE_WORKER_REALESRGAN_WEIGHTS=/srv/models/Real-ESRGAN/weights/RealESRGAN_x4plus.pth
UPSCALE_WORKER_REALESRGAN_TILE=256
UPSCALE_WORKER_PARTGLEE_REPOSITORY=/srv/models/PartGLEE
UPSCALE_WORKER_PARTGLEE_PYTHON=/srv/envs/partglee/bin/python
UPSCALE_WORKER_PARTGLEE_WEIGHTS=/srv/models/PartGLEE/projects/PartGLEE/checkpoint/PartGLEE_RN50.pth
UPSCALE_WORKER_PARTGLEE_CONFIG=projects/PartGLEE/configs/Inference/RN50/paco.yaml
UPSCALE_WORKER_PARTGLEE_THRESHOLD=0.5
UPSCALE_WORKER_PARTGLEE_MAX_DIMENSION=1280
UPSCALE_WORKER_SEE_THROUGH_REPOSITORY=/srv/models/see-through
UPSCALE_WORKER_SEE_THROUGH_PYTHON=/srv/envs/see-through/bin/python
UPSCALE_WORKER_SEE_THROUGH_RESOLUTION=1280
UPSCALE_WORKER_SEE_THROUGH_GROUP_OFFLOAD=false
